{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Expo Web",
      "type": "shell",
      "command": "npm",
      "args": ["run", "web", "--", "--port", "8081"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "expo",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting project at",
          "endsPattern": "^Waiting on http://localhost:8081"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
